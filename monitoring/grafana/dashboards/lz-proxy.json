          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(lz_outbound_latency_seconds_bucket[$__range])) by (le, route)))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "route": "Route",
              "Value": "p95"
            }
          }
        }
      ]
    },
