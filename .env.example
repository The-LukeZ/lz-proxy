# Copy to .env and fill in. .env is git-ignored; never commit it.

# Optional parts to start with a plain `docker compose up -d`.
# Empty = proxy only. Examples:
#   COMPOSE_PROFILES=monitoring
#   COMPOSE_PROFILES=monitoring,tunnel
COMPOSE_PROFILES=

# Grafana admin password (user: admin). Required for the monitoring and tunnel
# profiles. At least 12 characters; Grafana refuses to start otherwise.
GRAFANA_ADMIN_PASSWORD=

# Token of a remote-managed Cloudflare Tunnel. Required for the tunnel profile
# (which also starts Prometheus and Grafana).
CLOUDFLARE_TUNNEL_TOKEN=
